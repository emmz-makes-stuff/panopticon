{
  "//": "Local development only: matches compose.yaml. These credentials are public and must never be used elsewhere.",
  "Urls": "http://localhost:7480",
  "ConnectionStrings": {
    "Panopticon": "Host=localhost;Port=5432;Database=panopticon;Username=panopticon;Password=panopticon"
  },
  "Panopticon": {
    "BootstrapToken": "dev-bootstrap-token",
    "S3": {
      "ServiceUrl": "http://localhost:8333",
      "AccessKey": "panopticon-local",
      "SecretKey": "panopticon-local-secret",
      "Bucket": "panopticon-documents",
      "ForcePathStyle": true
    }
  }
}
